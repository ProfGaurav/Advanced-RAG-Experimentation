OPENAI_API_KEY=your-openai-key-here
VIDEO_ID=Gfr50f6ZBvo
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
TEMPERATURE=0.2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_K=4
FETCH_K=100
HISTORY_TURNS=6
RERANKER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
# Guardrails
# Relevance gate on the cross-encoder score (ms-marco-MiniLM logits). Calibrated on the
# Lex Fridman #299 index: off-topic questions ~ -11 (one at -6.4), on-topic -4..+4.
# Empty = off. Retune if you change RERANKER_MODEL.
MIN_RERANK_SCORE=-6
MAX_QUESTION_CHARS=1000
# openai = OpenAI moderation endpoint (free) on every question; none = off
MODERATION=openai
VECTORSTORE_DIR=data/vectorstore
REGISTRY_PATH=data/videos.json
CHAT_SESSIONS_PATH=data/chat_sessions.json
TRANSCRIPTS_DIR=data/transcripts
TRANSCRIPT_LANGUAGES=en
